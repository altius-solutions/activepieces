## It's advisable to consult the documentation and use the tools/deploy.sh to generate the passwords, keys, instead of manually filling them.

AP_ENGINE_EXECUTABLE_PATH=dist/packages/engine/main.js

## Random Long Password (Optional for community edition)
AP_API_KEY=

## 256 bit encryption key, 32 hex character
AP_ENCRYPTION_KEY=

## JWT Secret
AP_JWT_SECRET=

AP_ENVIRONMENT=prod
AP_FRONTEND_URL=http://localhost:8080
AP_WEBHOOK_TIMEOUT_SECONDS=30
AP_TRIGGER_DEFAULT_POLL_INTERVAL=5
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_HOST=postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=postgres
AP_POSTGRES_PASSWORD=
AP_EXECUTION_MODE=UNSANDBOXED
AP_REDIS_HOST=redis
AP_REDIS_PORT=6379
AP_FLOW_TIMEOUT_SECONDS=600
## Off by default in this fork. The upstream default reports usage to Activepieces.
AP_TELEMETRY_ENABLED=false

## Optional Altius Flow overrides. Defaults live in packages/core/shared/src/lib/core/common/brand.ts.
## See ALTIUS_BRANDING.md. Uncomment only the values you want to change.
# AP_BRAND_PRODUCT_NAME=Altius Flow
# AP_BRAND_PRIMARY_COLOR=#4F46E5
# AP_BRAND_PRIMARY_HOVER=#4338CA
# AP_BRAND_WEBSITE_URL=https://altiusol.com
# AP_BRAND_DOCS_URL=https://altiusol.com
# AP_BRAND_SUPPORT_URL=https://altiusol.com
# AP_SMTP_SENDER_NAME=Altius Flow
AP_TEMPLATES_SOURCE_URL="https://cloud.activepieces.com/api/v1/flow-templates"

## Tool-search engine — semantic action/trigger discovery for the MCP (default off).
AP_TOOL_SEARCH_ENABLED=false
## OpenAI API key that funds ALL tool-search embedding (catalog backfill, reindex on new pieces, and
## search queries) when tool-search is enabled. If unset, tool-search falls back to each platform's
## configured OpenAI provider key, then to keyword-only search. Only used when AP_TOOL_SEARCH_ENABLED=true.
AP_OPENAI_API_KEY=
